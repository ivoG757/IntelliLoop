@model ProcessingJobViewModel
@using IntelliLoop.Web.Mapping

@{
    ViewData["Title"] = "Processing Lecture";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/processing.css" asp-append-version="true" />
}

<section class="process-state">
    <div class="empty-symbol">
        <i class="bi bi-file-earmark-music"></i>
    </div>

    <h1>@Model.Title</h1>
    <p>Your audio is being prepared.</p>

    <ol class="process-list">
        @foreach (var step in Model.Steps)
        {
            <li class="@(step.IsDone ? "step-done" : step.IsCurrent ? "step-current" : "")">
                <span class="step-icon">
                    @if (step.IsDone)
                    {
                        <i class="bi bi-check"></i>
                    }
                </span>

                @step.Name
            </li>
        }
    </ol>
</section>