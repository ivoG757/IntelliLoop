@model SidebarViewModel
@using IntelliLoop.Core.Entities.Enums;

<aside class="sidebar" aria-label="Workspace navigation">
    <div class="sidebar-footer">
    <span class="avatar">@Model.UserEmail[0]</span>
    <span class="sidebar-user-email" title="@Model.UserEmail">@Model.UserEmail</span>

    <form asp-area="Identity"
          asp-page="/Account/Logout"
          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
          method="post"
          class="sidebar-logout-form">
        <button type="submit"
                class="sidebar-logout"
                title="Log out"
                aria-label="Log out">
            <i class="bi bi-box-arrow-right"></i>
        </button>
    </form>
</div>

    <h2 class="sidebar-heading">My Lectures</h2>

    <nav class="sidebar-list">
        <a class="side-action" asp-action="Upload" asp-controller="Processing">
            <i class="bi bi-plus-lg"></i>
            <span>New Lecture</span>
        </a>

        <div class="side-divider"></div>

        @foreach (var current in Model.Lectures)
        {
            var isProcessing = current.Status != LectureGenerationStatus.Completed && current.Status != LectureGenerationStatus.Failed;

            var currentRotue = Context.Request.RouteValues["id"]?.ToString();

            var isCurrent = current.Status == LectureGenerationStatus.Completed 
            ? currentRotue == current.LectureId?.ToString()
            : currentRotue == current.JobId.ToString();

            <div class="lecture-row">
                @if (isProcessing)
                {
                    <a class="lecture-link processing @(isCurrent ? "active" : "")" 
                       asp-controller="Processing" asp-action="Index" asp-route-id="@current.JobId">
                        <span class="status-pulse"></span>
                        <span class="lecture-link-text">
                            <span class="lecture-title">@current.Title</span>
                        </span>
                    </a>
                }
                else if (current.Status == LectureGenerationStatus.Failed)
                {
                    <a class="lecture-link failed" asp-controller="Processing" asp-action="Failed" asp-route-id="@current.JobId">
                        <i class="bi bi-exclamation-triangle"></i>
                        <span class="lecture-link-text">
                            <span class="lecture-title">@current.Title</span>
                        </span>
                    </a>
                }
                else
                {
                    <a class="lecture-link @(isCurrent ? "active" : "")" asp-controller="Lecture" asp-action="Index" asp-route-id="@current.LectureId">
                        <i class="bi bi-file-earmark-text"></i>
                        <span class="lecture-link-text">
                            <span class="lecture-title">@current.Title</span> 
                        </span>
                    </a>
                }

                @if (!isProcessing && current.Status != LectureGenerationStatus.Failed)
                {
                    <a class="lecture-delete-route" asp-controller="Lecture" asp-action="Delete" asp-route-id="@current.LectureId"
                    title="Delete lecture" aria-label="Delete @current.Title">
                        <i class="bi bi-trash"></i>
                    </a>
                }
            </div>
        }
    </nav>
</aside>