@model LoginViewModel;

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<div class="account-container">
    <div class="account-box">
        <h2 class="text-center mb-4">Login</h2>
        
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-bg-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-bg-danger"></span>
            </div>

            <div class="float-end">
                <a asp-controller="Account" asp-action="VerifyEmail" class="text-decoration-none">
                    Forgot password?
                </a>
            </div>
           
            <div class="form-check mb-3">
                <div class="form-check-label">
                    <input asp-for="RememberMe" class="form-check-input"/>
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>
            </div>
            <input type="submit" value="Login" class="btn btn-success w-100 p-2 mb-0" />
            <div class="text-center">
                <p class="text-center mt-2">
                    Don't have an account? <a asp-controller="Account" asp-action="Register" class="text-decoration-none">Register</a>
                </p>
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none mt-3">Back</a>
            </div>
            </form>
    </div>
</div>
@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}