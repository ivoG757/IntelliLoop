@{
    ViewData["Title"] = "Transcription";
}
<h1>Audio Transcription Test</h1>

<form asp-action="upload" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label for="audioFile">Select Audio File:</label>
        <input type="file" class="form-control" id="audioFile" name="file" accept="audio/*" />
    </div>
    <button type="submit" class="btn btn-primary">Transcribe</button>
</form>
@if (ViewBag.Transcript != null)
{
    <hr />

    <h2>Transcript</h2>

    <pre>@ViewBag.Transcript</pre>
}

<h1>AI Summarization Test</h1>
<form asp-action="summarize" method="post">
    <div class ="form-group">
        <label for="transcript">Transcript:</label>
        <textarea class="form-control" id="transcript" name="transcript" rows="10" placeholder="Enter the transcript here"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Summarize</button>
</form>

@if (ViewBag.Lecture != null)
{
    <hr />

    <h2>AI Summary</h2>

    <pre>@ViewBag.Lecture</pre>
}
