@model IntelliLoop.Web.Models.LectureViewModel

@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<article class="document">

    <div class="document-kicker">
        <i class="bi bi-book"></i>
        Study notes
        <span class="kicker-dot"></span>
        Lecture
    </div>

    <h1>@Model.Title</h1>

    <div class="document-subtitle">
        <i class="bi bi-clock"></i>
        Lecture recording
    </div>

    @* Audio player *@
    <div class="audio-player">
        <div class="player-info">
            <span class="player-label">Original lecture audio</span>
            <audio class="audio-controls" controls preload="metadata">
                <source src="@Url.Action("Audio", "Lecture", new { id = Model.JobId })" type="audio/wav">
                Your browser does not support audio playback.
            </audio>
        </div>
    </div>

    @* Summary *@
    <section class="document-section">
        <h2 class="section-title">Summary</h2>

        <p class="body-copy">
            @Model.Summary
        </p>
    </section>

    @* Key Concepts *@
    <section class="document-section">
        <h2 class="section-title">Key Concepts</h2>

        <ul class="concept-list">
            @foreach (var concept in Model.KeyConcepts)
            {
                <li>
                    <span class="concept-bullet"></span>
                    <div>
                        @concept
                    </div>
                </li>
            }
        </ul>
    </section>

    @* Notes *@
    <section class="document-section">
        <h2 class="section-title">Notes</h2>

        <ol class="notes-list">
            @foreach (var note in Model.Notes)
            {
                <li>
                    <strong>@note.Title</strong>
                    @note.Content
                </li>
            }
        </ol>
    </section>

    @* Transcript *@
    <details class="transcript">
        <summary>
            <i class="bi bi-file-earmark-text"></i>
            Transcript
            <i class="bi bi-chevron-down"></i>
        </summary>

        <div class="transcript-copy">
            @Model.Transcript
        </div>
    </details>

</article>

@section Styles {
    <link rel="stylesheet"
          href="~/css/lecture.css"
          asp-append-version="true" />
}