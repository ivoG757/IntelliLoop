@{
    ViewData["Title"] = "Processing Failed";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container py-5">
    <div class="mx-auto text-center" style="max-width: 480px;">
        <h1 class="h3 mb-3">Processing failed</h1>

        <p class="text-muted mb-4">
            We couldn't process this lecture.
        </p>

        <form asp-controller="Lecture" asp-action="DeleteFailed" method="post">
            <input type="hidden" name="id" value="@ViewBag.JobId" />
            <button type="submit" class="btn-danger btn">
                Delete failed lecture
            </button>
        </form>
    </div>
</div>