@model EditLectureViewModel
@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/edit.css" asp-append-version="true" />
}

<article class="document">
    <form asp-controller="Lecture" asp-action="Edit" method="post">
        <input asp-for="Id" type="hidden" />

        <div class="document-kicker">
            <i class="bi bi-book"></i>
            Study notes
            <span class="kicker-dot"></span>
            Editing Lecture
        </div>

        <label asp-for="Title" class="visually-hidden">Lecture title</label>
        <h1>
            <textarea asp-for="Title" class="edit-field" rows="1" data-single-line></textarea>
        </h1>
        <span asp-validation-for="Title" class="text-danger field-error"></span>

        <div class="document-subtitle">
            <i class="bi bi-clock"></i>
            Lecture recording
        </div>

        <div class="audio-player">
            <div class="player-info">
                <span class="player-label">Original lecture audio</span>
                <audio class="audio-controls" controls preload="metadata">
                    <source src="@Url.Action("Audio", "Lecture", new { id = Model.Id })" type="audio/wav">
                    Your browser does not support audio playback.
                </audio>
            </div>
        </div>

        <section class="document-section">
            <h2 class="section-title">Summary</h2>

            <div class="body-copy">
                <label asp-for="Summary" class="visually-hidden">Summary</label>
                <textarea asp-for="Summary" class="edit-field" rows="1"></textarea>
                <span asp-validation-for="Summary" class="text-danger field-error"></span>
            </div>
        </section>

        <section class="document-section">
            <h2 class="section-title">Key Concepts</h2>

            <button type="button" id="add-concept" class="add-btn">
                <i class="bi bi-plus-lg"></i>
                Add concept
            </button>

            <ul class="concept-list" id="concept-list">
                @for (int i = 0; i < Model.KeyConcepts.Count; i++)
                {
                    <li class="concept-item">
                        <span class="concept-bullet"></span>
                        <div>
                            <textarea asp-for="KeyConcepts[i]" class="edit-field" rows="1" data-single-line></textarea>
                            <span asp-validation-for="KeyConcepts[i]" class="text-danger field-error"></span>
                        </div>

                        <button type="button" class="row-action delete-concept" aria-label="Delete concept" title="Delete concept">
                            <i class="bi bi-trash"></i>
                        </button>
                    </li>
                }
            </ul>
        </section>

        <section class="document-section">
            <h2 class="section-title">Notes</h2>

            <button type="button" id="add-note" class="add-btn">
                <i class="bi bi-plus-lg"></i>
                Add note
            </button>

            <ol class="notes-list">
                @for (int i = 0; i < Model.Notes.Count; i++)
                {
                    <li class="note-item @(Model.Notes[i].Id == null ? "note-new" : "")">
                        <input asp-for="Notes[i].Id" type="hidden" />

                        <div class="note-field">
                            <label asp-for="Notes[i].Title" class="note-label">Title:</label>
                            <textarea asp-for="Notes[i].Title" class="edit-field note-title" rows="1" data-single-line></textarea>
                        </div>
                        <span asp-validation-for="Notes[i].Title" class="text-danger field-error"></span>

                        <div class="note-field">
                            <label asp-for="Notes[i].Content" class="note-label">Content:</label>
                            <textarea asp-for="Notes[i].Content" class="edit-field" rows="1"></textarea>
                        </div>
                        <span asp-validation-for="Notes[i].Content" class="text-danger field-error"></span>

                        <button type="button" class="row-action delete-note" aria-label="Delete note" title="Delete note">
                            <i class="bi bi-trash"></i>
                        </button>
                    </li>
                }
            </ol>
        </section>

        <div class="edit-actions">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg"></i>
                Save
            </button>

            <a asp-action="Index" asp-route-id="@Model.Id"
               class="btn btn-outline-secondary">
                Cancel
            </a>
        </div>
    </form>
</article>

@section Scripts {
    <script src="~/js/edit.js" asp-append-version="true"></script>
}
